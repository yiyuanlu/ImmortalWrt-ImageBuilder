#!/bin/sh

# Only replace the factory image's empty root password. A preserved or
# user-changed password must never be reset by a later image upgrade.
root_hash='$1$N5105A9p$RkF0ZTUKPjcEE2R0FTXjt.'

grep -q '^root::' /etc/shadow || exit 0
sed -i "s|^root:[^:]*:|root:${root_hash}:|" /etc/shadow || exit 1

exit 0
